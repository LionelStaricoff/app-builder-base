# Copiar a .env (que está ignorado por git) para correr contra Postgres.
# Para desarrollo local sin base de datos, usar el perfil `local` (H2 en memoria)
# con .\scripts\dev.ps1 y NO completar estas variables.

# --- Base de datos ---
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Stripe (opcional en local; sin keys el checkout falla con mensaje claro) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- URL pública de la app (success/cancel de Checkout) ---
APP_BASE_URL=http://localhost:8080

# --- Didit / KYC (opcional en local; identity.verification.enabled controla el gate) ---
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_CALLBACK_URL=http://localhost:8080/verificacion/callback

# --- Datos demo (solo se siembran contra H2) ---
# Si queda vacía, el seeder aborta y no crea usuarios.
DEMO_PASSWORD=

# --- Gate de verificación de identidad (false = permite probar sin KYC) ---
IDENTITY_VERIFICATION_ENABLED=false
