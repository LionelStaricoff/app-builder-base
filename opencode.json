{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "foxmcp": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": true
    },
    "graft": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nanonets/graft",
        "mcp"
      ],
      "enabled": true
    }
  }
}
